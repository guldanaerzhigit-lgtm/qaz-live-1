rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function admin(){return signedIn() && request.auth.token.admin == true;}
  function activeUser(){return signedIn() && !exists(/databases/$(database)/documents/blockedUsers/$(request.auth.uid));}
  match /posts/{postId} {
   allow read: if signedIn();
   allow create: if activeUser() && request.resource.data.uid==request.auth.uid && request.resource.data.text is string && request.resource.data.text.size()>0 && request.resource.data.text.size()<=500 && request.resource.data.likes==0 && request.resource.data.likedBy==[];
   allow update: if activeUser() && (
    (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes','likedBy']) && request.resource.data.likedBy is list && request.resource.data.likes is int && request.resource.data.likes>=0 && ((request.resource.data.likedBy.hasAll(resource.data.likedBy) && request.resource.data.likedBy.size()==resource.data.likedBy.size()+1 && request.resource.data.likedBy.hasAny([request.auth.uid]) && !resource.data.likedBy.hasAny([request.auth.uid]) && request.resource.data.likes==resource.data.likes+1)||(resource.data.likedBy.hasAll(request.resource.data.likedBy) && resource.data.likedBy.size()==request.resource.data.likedBy.size()+1 && resource.data.likedBy.hasAny([request.auth.uid]) && !request.resource.data.likedBy.hasAny([request.auth.uid]) && request.resource.data.likes==resource.data.likes-1)))
   );
   allow delete: if signedIn() && (resource.data.uid==request.auth.uid || admin());
   match /comments/{commentId} {
    allow read: if signedIn();
    allow create: if activeUser() && request.resource.data.uid==request.auth.uid && request.resource.data.text is string && request.resource.data.text.size()>0 && request.resource.data.text.size()<=500;
    allow update: if signedIn() && resource.data.uid==request.auth.uid;
    allow delete: if signedIn() && (resource.data.uid==request.auth.uid || admin());
   }
  }
  match /users/{userId} {
   allow read: if signedIn();
   allow create: if signedIn() && request.auth.uid==userId && !request.resource.data.keys().hasAny(['role','admin','disabled','labAccess'])
     || admin() && request.resource.data.keys().hasOnly(['labAccess']) && request.resource.data.labAccess==true;
   allow update: if signedIn() && ((request.auth.uid==userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role','admin','disabled','labAccess']))
     || admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['labAccess']) && request.resource.data.labAccess==true);
   allow delete: if admin();
   match /following/{targetId} {
    allow read: if signedIn() && (request.auth.uid==userId || request.auth.uid==targetId);
    allow create: if signedIn() && request.auth.uid==userId && targetId!=userId && request.resource.data.uid==targetId;
    allow delete: if signedIn() && (request.auth.uid==userId || request.auth.uid==targetId);
   }
   match /followers/{followerId} {
    allow read: if signedIn();
    allow create: if signedIn() && request.auth.uid==followerId && request.resource.data.uid==followerId;
    allow delete: if signedIn() && (request.auth.uid==followerId || request.auth.uid==userId);
   }
   match /notifications/{notificationId} {
    allow read,update,delete: if signedIn() && request.auth.uid==userId;
    allow create: if signedIn() && request.resource.data.fromUid==request.auth.uid;
   }
  }
  match /blockedUsers/{blockedUid} {
   allow read: if signedIn() && (request.auth.uid == blockedUid || admin());
   allow create,update,delete: if admin() && blockedUid != request.auth.uid;
  }
  match /reports/{reportId} {
   allow create: if activeUser()
     && request.resource.data.reporterUid == request.auth.uid
     && request.resource.data.postId is string
     && reportId == request.resource.data.postId + '_' + request.auth.uid
     && !exists(/databases/$(database)/documents/reports/$(reportId))
     && request.resource.data.reason in ['spam','harassment','hate','violence','other']
     && request.resource.data.status == 'open'
     && request.resource.data.details is string
     && request.resource.data.details.size() <= 300;
   allow read: if admin();
   allow update: if admin()
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedAt','reviewedBy'])
     && request.resource.data.status == 'resolved'
     && request.resource.data.reviewedBy == request.auth.uid;
   allow delete: if admin();
  }
  match /chats/{chatId} {
   allow read: if activeUser() && request.auth.uid in resource.data.participants;
   allow create: if activeUser()
     && request.resource.data.participants is list
     && request.resource.data.participants.size() == 2
     && request.auth.uid in request.resource.data.participants
     && request.resource.data.lastSenderUid == '';
   allow update: if activeUser()
     && request.auth.uid in resource.data.participants
     && request.resource.data.participants == resource.data.participants
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage','lastSenderUid','unreadFor','updatedAt'])
     && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unreadFor']) && request.resource.data.unreadFor[request.auth.uid] == 0)
       || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage','lastSenderUid','unreadFor','updatedAt']) && request.resource.data.lastSenderUid == request.auth.uid));
   allow delete: if false;
   match /messages/{messageId} {
    allow read: if activeUser() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    allow create: if activeUser()
      && request.resource.data.senderUid == request.auth.uid
      && request.resource.data.text is string
      && request.resource.data.text.size() > 0
      && request.resource.data.text.size() <= 2000
      && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    allow update,delete: if false;
   }
  }
  match /worldDecorations/{decorationId} {
   allow read: if signedIn();
   allow create,update,delete: if admin();
  }
  match /labRequests/{requestId} {
   allow create: if signedIn() && request.resource.data.uid==request.auth.uid && request.resource.data.status=='pending';
   allow read: if signedIn() && (resource.data.uid==request.auth.uid || admin());
   allow update: if admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedAt','reviewedBy']) && request.resource.data.status in ['approved','revoked'] && request.resource.data.reviewedBy == request.auth.uid;
   allow delete: if admin();
  }
  match /{document=**} {allow read,write: if false;}
 }
}